# Optional configuration for deploy/performance/bootstrap-efs.sh
#
#   cp efs.env.example efs.env && $EDITOR efs.env && ./bootstrap-efs.sh
#
# Nothing here is required. The script runs with no config file at all and
# derives the region from the cluster. Override only what you need.
#
# This file covers the AWS resources the script provisions, plus which repo and
# which components this particular cluster should get. It deliberately does not
# configure the model, tensor parallelism, cache sizes or namespaces: those are
# deployment configuration and live in the charts' values.yaml, under version
# control where a reviewer can see them change.
#
# No secrets belong here. The script uses whatever credentials your `aws` CLI is
# already configured with.

# ---------------------------------------------------------------------------
# AWS
# ---------------------------------------------------------------------------

# Region. Leave unset to derive it from the cluster's own nodes, which is safer
# than a default in ~/.aws/config: EFS and its mount targets must live in the
# cluster's region or the nodes cannot reach them.
# AWS_REGION=us-west-2

# Name tag for the filesystem. The script adopts an existing filesystem with this
# name that is tagged for this cluster, so re-runs never create a second one and
# never orphan a warm cache.
EFS_NAME=neuron-cache

# elastic scales throughput automatically and suits a cache with bursty reads.
# Alternatives: bursting, provisioned.
EFS_THROUGHPUT_MODE=elastic

# generalPurpose has the lowest per-operation latency, which matters because the
# compile cache is many small files. maxIO trades latency for parallelism.
EFS_PERFORMANCE_MODE=generalPurpose

EFS_ENCRYPTED=true

# ---------------------------------------------------------------------------
# GitOps
# ---------------------------------------------------------------------------

# Namespace of the ArgoCD instance. The default OpenShift GitOps instance is
# openshift-gitops.
GITOPS_NAMESPACE=openshift-gitops

# Where the charts are read from. Point these at your fork if you maintain one.
# Pin PERF_REPO_REVISION to a release tag rather than main if you do not want
# upstream merges to reach this cluster.
PERF_REPO_URL=https://github.com/awslabs/operator-for-ai-chips-on-aws.git
PERF_REPO_REVISION=main

# ---------------------------------------------------------------------------
# Which components this cluster gets
#
# These become labels on the ArgoCD cluster Secret, which is what the
# ApplicationSets select on. Per-cluster by nature, which is why they are here
# rather than in a chart.
# ---------------------------------------------------------------------------

ENABLE_STORAGE=true
ENABLE_NEURON_OPERATOR=true
ENABLE_OAI=true
