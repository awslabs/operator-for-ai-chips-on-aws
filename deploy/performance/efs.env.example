# Configuration for deploy/performance/bootstrap-efs.sh
#
#   cp efs.env.example efs.env && $EDITOR efs.env && ./bootstrap-efs.sh
#
# Everything here is non-secret. No AWS keys or tokens belong in this file; the
# script uses whatever credentials your `aws` CLI is already configured with.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# AWS region the cluster runs in.
AWS_REGION=us-east-2

# ---------------------------------------------------------------------------
# EFS filesystem
# ---------------------------------------------------------------------------

# Name tag for the filesystem. The script adopts an existing filesystem with
# this name that is tagged for this cluster, so re-runs never create a second
# one and never orphan a warm cache.
EFS_NAME=neuron-cache

# elastic scales throughput automatically and suits a cache with bursty reads.
# Alternatives: bursting, provisioned.
EFS_THROUGHPUT_MODE=elastic

# generalPurpose has the lowest per-operation latency, which matters because the
# compile cache is many small files. maxIO trades latency for parallelism.
EFS_PERFORMANCE_MODE=generalPurpose

EFS_ENCRYPTED=true

# ---------------------------------------------------------------------------
# GitOps
# ---------------------------------------------------------------------------

# Namespace of the ArgoCD instance. The default OpenShift GitOps instance is
# openshift-gitops.
GITOPS_NAMESPACE=openshift-gitops

# Where the charts are read from. Point these at your fork if you maintain one.
# Pin PERF_REPO_REVISION to a release tag (for example v1.2.0) rather than main
# if you do not want upstream merges to reach this cluster.
PERF_REPO_URL=https://github.com/awslabs/operator-for-ai-chips-on-aws.git
PERF_REPO_REVISION=main

# ---------------------------------------------------------------------------
# Workload
# ---------------------------------------------------------------------------

SERVING_NAMESPACE=neuron-inference
MODEL_NAME=meta-llama/Llama-3.1-8B-Instruct

# Must not exceed the NeuronCores available on the instance type.
# inf2.xlarge and inf2.8xlarge have 1 device / 2 cores.
TENSOR_PARALLEL_SIZE=2

STORAGE_CLASS_NAME=efs-sc
COMPILE_CACHE_SIZE=50Gi
MODEL_CACHE_SIZE=100Gi

# ---------------------------------------------------------------------------
# Which components GitOps should install
# ---------------------------------------------------------------------------

ENABLE_STORAGE=true
ENABLE_NEURON_OPERATOR=true
ENABLE_OAI=true
